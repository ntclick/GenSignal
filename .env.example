# GenSignal Environment Configuration Example

# ─── GenLayer Network & Wallet ───────────────────────────────────────────────
# Private key of the GenLayer Testnet wallet (with native GEN balance for fees)
GENLAYER_PRIVATE_KEY=your_private_key_here
# Network name: "bradbury" (default), "studionet", or "local"
GENLAYER_NETWORK=bradbury

# ─── On-Chain Contract Addresses (Singleton Mode) ────────────────────────────
# Persisted contracts on GenLayer Bradbury Testnet (Skip re-deploying on restart)
TREASURY_CONTRACT_ADDRESS=0x9e70bFAD6bd7721758ec3dae57622616d63Ed975
ORACLE_CONTRACT_ADDRESS=0x5Fc7020bD35405dC653727b2c4694424da5D29BC

# ─── Market Data APIs (Optional / Recommended) ───────────────────────────────
# CoinGecko Demo API key for live price feed ticker
COINGECKO_API_KEY=your_coingecko_api_key_here

# ─── Frontend & Application ──────────────────────────────────────────────────
# Backend API server URL
VITE_BACKEND_URL=http://localhost:8001
